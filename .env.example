SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=notesapp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

GROQ_API_KEY=your-groq-key-here
SERPAPI_KEY=your-serpapi-key-here

# Required for mcp_server: a JWT access token (from POST /api/auth/token/)
# identifying which user the MCP server's notes_list/create_note act as.
MCP_ACCESS_TOKEN=your-jwt-access-token-here

# Optional: directory the agent's file_read tool is sandboxed to.
# Defaults to ./agent/workspace if not set.
FILE_READ_ROOT=./agent/workspace
